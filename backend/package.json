    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "prisma": "^7.0.1",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "uuid": "^9.0.0",
    "zod": "^4.1.13"
