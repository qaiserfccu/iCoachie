{
  "name": "icoachie-backend-ts",
  "version": "1.0.0",
  "description": "iCoachie backend in TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "start": "npm run build && npm run dev",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "migrate": "node dist/migrations/run.js",
    "swagger:export": "ts-node scripts/export-swagger.ts",
    "test": "NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:smoke": "jest --testPathPatterns=smoke.test.ts --verbose --no-coverage --runInBand",
    "test:unit": "jest --config=jest.unit.config.js --verbose --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.0.0",
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "uuid": "^9.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.6.8",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.6"
  }
}
