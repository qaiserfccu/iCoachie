// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All enums now managed via database tables for flexibility

enum FileType {
  AVATAR
  DOCUMENT
  CLUB_LOGO
  CERTIFICATE
  OTHER
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  primaryRoleId Int?     // Main role for the user
  statusId      Int?     // Reference to UserStatus lookup
  avatarUrl     String?
  clubId        Int?     // Tenant ID for row-level multi-tenancy
  facilityId    Int?     // For facility staff
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // Soft delete

  // Relations
  primaryRole   Role?    @relation("UserPrimaryRole", fields: [primaryRoleId], references: [id])
  status        UserStatus? @relation(fields: [statusId], references: [id])
  club          Club?    @relation("ClubAdmin", fields: [clubId], references: [id])
  facility      Facility? @relation("FacilityStaff", fields: [facilityId], references: [id])
  managedClub   Club?    @relation("ClubManager")
  managedFacility Facility? @relation("FacilityManager")
  students      Student[] @relation("StudentUser")
  children      Student[] @relation("ParentUser")
  coachedStudents Student[] @relation("CoachUser")
  coachedSessions Session[] @relation("CoachSessions")
  coachProfile  Coach?
  sentMessages  Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  payments      Payment[]
  bookings      Booking[] @relation("BookingFreelancer")
  clientBookings Booking[] @relation("BookingClient")
  reviewsGiven  Review[] @relation("ReviewReviewer")
  reviewsReceived Review[] @relation("ReviewReviewee")
  evaluations   Evaluation[]
  attendances   Attendance[]
  profile       Profile?
  userRoles     UserRoleAssignment[]
  passwordResets PasswordReset[]
  uploadedFiles  File[]
  managedVenues Venue[] @relation("VenueManager")
  managedGrounds Ground[] @relation("GroundManager")
  equipmentBookings EquipmentBooking[]
  assignedMaintenanceTasks MaintenanceTask[]

  @@map("users")
}

model Club {
  id          Int      @id @default(autoincrement())
  name        String
  adminId     Int      @unique
  location    String?
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete

  // Relations
  admin       User     @relation("ClubManager", fields: [adminId], references: [id])
  users       User[]   @relation("ClubAdmin")
  students    Student[]
  coaches     Coach[]
  sessions    Session[]
  facilities  ClubFacility[]

  @@map("clubs")
}

model ClubFacility {
  id          Int      @id @default(autoincrement())
  clubId      Int
  facilityId  Int
  createdAt   DateTime @default(now())
  
  club        Club     @relation(fields: [clubId], references: [id])
  facility    Facility @relation(fields: [facilityId], references: [id])

  @@unique([clubId, facilityId])
  @@map("club_facilities")
}

model Student {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  parentId  Int?
  clubId    Int?     // Optional: Student might be direct to facility or freelancer
  facilityId Int?    // Optional: Student might belong to a facility directly
  coachId   Int?
  name      String
  age       Int?
  level     String?
  sport     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  user      User     @relation("StudentUser", fields: [userId], references: [id])
  parent    User?    @relation("ParentUser", fields: [parentId], references: [id])
  club      Club?    @relation(fields: [clubId], references: [id])
  facility  Facility? @relation(fields: [facilityId], references: [id])
  coach     User?    @relation("CoachUser", fields: [coachId], references: [id])
  enrollments SessionEnrollment[]
  attendances Attendance[]
  evaluations Evaluation[]

  @@map("students")
}

model Coach {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  clubId            Int?
  facilityId        Int?     // Optional: Coach might work for a facility
  specializations    String[]
  experienceYears   Int?
  certification     String?
  hourlyRate        Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime? // Soft delete

  // Relations
  user              User     @relation(fields: [userId], references: [id])
  club              Club?    @relation(fields: [clubId], references: [id])
  facility          Facility? @relation(fields: [facilityId], references: [id])

  @@map("coaches")
}

model Session {
  id              Int           @id @default(autoincrement())
  coachId         Int
  clubId          Int?
  title           String
  description     String?
  sessionDate     DateTime
  startTime       DateTime
  endTime         DateTime
  location        String?
  maxCapacity     Int?
  currentEnrolled Int           @default(0)
  statusId        Int?          // Reference to SessionStatus lookup
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     // Soft delete

  // Relations
  coach           User          @relation("CoachSessions", fields: [coachId], references: [id])
  club            Club?         @relation(fields: [clubId], references: [id])
  status          SessionStatus? @relation(fields: [statusId], references: [id])
  enrollments     SessionEnrollment[]
  attendances     Attendance[]
  evaluations     Evaluation[]

  @@map("sessions")
}

model SessionEnrollment {
  id        Int      @id @default(autoincrement())
  sessionId Int
  studentId Int
  enrolledAt DateTime @default(now())
  status    String   @default("confirmed")
  deletedAt DateTime? // Soft delete

  // Relations
  session   Session  @relation(fields: [sessionId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("session_enrollments")
}

model Attendance {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  studentId   Int
  statusId    Int?             // Reference to AttendanceStatus lookup
  checkinTime DateTime?
  notes       String?
  recordedBy  Int
  recordedAt  DateTime         @default(now())
  deletedAt   DateTime?        // Soft delete

  // Relations
  session     Session          @relation(fields: [sessionId], references: [id])
  student     Student          @relation(fields: [studentId], references: [id])
  status      AttendanceStatus? @relation(fields: [statusId], references: [id])
  recorder    User             @relation(fields: [recordedBy], references: [id])

  @@unique([sessionId, studentId])
  @@map("attendance")
}

model Evaluation {
  id              Int      @id @default(autoincrement())
  studentId       Int
  coachId         Int
  sessionId       Int?
  evaluationType  String
  overallScore    Int?
  skills          Json?    // JSONB for detailed skill breakdown
  comments        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // Soft delete

  // Relations
  student         Student  @relation(fields: [studentId], references: [id])
  coach           User     @relation(fields: [coachId], references: [id])
  session         Session? @relation(fields: [sessionId], references: [id])

  @@map("evaluations")
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  paymentType    String
  statusId       Int?          // Reference to PaymentStatus lookup
  stripePaymentId String?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?     // Soft delete

  // Relations
  user           User          @relation(fields: [userId], references: [id])
  status         PaymentStatus? @relation(fields: [statusId], references: [id])

  @@map("payments")
}

model Message {
  id        Int      @id @default(autoincrement())
  fromUserId Int
  toUserId  Int
  subject   String?
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  deletedAt DateTime? // Soft delete

  // Relations
  fromUser  User     @relation("MessageSender", fields: [fromUserId], references: [id])
  toUser    User     @relation("MessageReceiver", fields: [toUserId], references: [id])

  @@map("messages")
}

model Booking {
  id          Int           @id @default(autoincrement())
  freelancerId Int
  clientId    Int
  venueId     Int?          // Optional venue booking
  sessionDate DateTime
  startTime   DateTime
  endTime     DateTime
  serviceType String
  amount      Decimal?      @db.Decimal(10, 2)
  statusId    Int?          // Reference to BookingStatus lookup
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?     // Soft delete

  // Relations
  freelancer  User          @relation("BookingFreelancer", fields: [freelancerId], references: [id])
  client      User          @relation("BookingClient", fields: [clientId], references: [id])
  venue       Venue?        @relation(fields: [venueId], references: [id])
  status      BookingStatus? @relation(fields: [statusId], references: [id])
  reviews     Review[]

  @@map("bookings")
}

model Review {
  id        Int      @id @default(autoincrement())
  reviewerId Int
  revieweeId Int
  bookingId Int?
  sessionId Int?
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now())
  deletedAt DateTime? // Soft delete

  // Relations
  reviewer  User     @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  reviewee  User     @relation("ReviewReviewee", fields: [revieweeId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  displayName String?
  bio       String?
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique  // e.g., SUPER_ADMIN, CLUB_ADMIN
  name        String              // Display name
  description String?
  scope       String?             // GLOBAL, CLUB, FACILITY, VENUE
  permissions Json?               // JSONB for flexible permission structure
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles   UserRoleAssignment[]
  primaryUsers User[]  @relation("UserPrimaryRole")

  @@map("roles")
}

model UserRoleAssignment {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  // Relations
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

// Lookup tables for dynamic enum values
model UserStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique  // ACTIVE, PENDING, SUSPENDED
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  
  users     User[]
  
  @@map("user_statuses")
}

model SessionStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique  // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  
  sessions  Session[]
  
  @@map("session_statuses")
}

model AttendanceStatus {
  id         Int      @id @default(autoincrement())
  code       String   @unique  // PRESENT, LATE, ABSENT
  name       String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  
  attendances Attendance[]
  
  @@map("attendance_statuses")
}

model PaymentStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique  // PENDING, COMPLETED, FAILED, REFUNDED
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  
  payments  Payment[]
  
  @@map("payment_statuses")
}

model BookingStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique  // PENDING, CONFIRMED, COMPLETED, CANCELLED
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  
  bookings  Booking[]
  
  @@map("booking_statuses")
}

model MembershipType {
  id        Int      @id @default(autoincrement())
  code      String   @unique  // STANDARD, PREMIUM
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  
  @@map("membership_types")
}

// Facility management models
model Facility {
  id          Int      @id @default(autoincrement())
  // clubId removed - use ClubFacility for many-to-many
  name        String
  managerId   Int?     @unique
  location    String?
  address     String?
  description String?
  amenities   String[] // Array of amenity strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  clubs       ClubFacility[]
  manager     User?    @relation("FacilityManager", fields: [managerId], references: [id])
  staff       User[]   @relation("FacilityStaff")
  venues      Venue[]
  grounds     Ground[]
  equipment   Equipment[]
  maintenanceTasks MaintenanceTask[]
  students    Student[]
  coaches     Coach[]
  
  @@map("facilities")
}

model Venue {
  id          Int      @id @default(autoincrement())
  facilityId  Int
  managerId   Int?     @unique
  name        String
  venueType   String   // Hall, Court, Studio, etc.
  capacity    Int?
  hourlyRate  Decimal? @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  amenities   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  facility    Facility @relation(fields: [facilityId], references: [id])
  manager     User?    @relation("VenueManager", fields: [managerId], references: [id])
  bookings    Booking[]
  schedules   VenueSchedule[]
  
  @@map("venues")
}

model Ground {
  id          Int      @id @default(autoincrement())
  facilityId  Int
  managerId   Int?     @unique
  name        String
  groundType  String   // Football, Cricket, Rugby, etc.
  surfaceType String?  // Grass, Artificial, etc.
  dimensions  String?  // Field dimensions
  capacity    Int?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  facility    Facility @relation(fields: [facilityId], references: [id])
  manager     User?    @relation("GroundManager", fields: [managerId], references: [id])
  schedules   GroundSchedule[]
  
  @@map("grounds")
}

// =============================================================================
// Card 21 - Venue Schedule & Ground Availability Models
// =============================================================================

model VenueSchedule {
  id          Int      @id @default(autoincrement())
  venueId     Int
  dayOfWeek   Int?     // 0-6 for recurring schedules (0=Sunday)
  specificDate DateTime? // For one-off availability
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  isRecurring Boolean  @default(true)
  isBlackout  Boolean  @default(false) // true = unavailable window
  notes       String?
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  venue       Venue    @relation(fields: [venueId], references: [id])
  
  @@map("venue_schedules")
}

model GroundSchedule {
  id          Int      @id @default(autoincrement())
  groundId    Int
  dayOfWeek   Int?     // 0-6 for recurring schedules (0=Sunday)
  specificDate DateTime? // For one-off availability
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  isRecurring Boolean  @default(true)
  isBlackout  Boolean  @default(false) // true = unavailable window
  notes       String?
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  ground      Ground   @relation(fields: [groundId], references: [id])
  
  @@map("ground_schedules")
}

model Equipment {
  id          Int      @id @default(autoincrement())
  facilityId  Int
  name        String
  type        String   // e.g., 'Ball', 'Net', 'Machine'
  quantity    Int      @default(1)
  condition   String   // 'New', 'Good', 'Fair', 'Poor'
  isBookable  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  facility    Facility @relation(fields: [facilityId], references: [id])
  bookings    EquipmentBooking[]

  @@map("equipment")
}

model EquipmentBooking {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  userId      Int
  bookingDate DateTime
  startTime   DateTime
  endTime     DateTime
  status      String   // 'Pending', 'Confirmed', 'Cancelled'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("equipment_bookings")
}

model MaintenanceTask {
  id          Int      @id @default(autoincrement())
  facilityId  Int
  title       String
  description String?
  status      String   // 'Pending', 'In Progress', 'Completed'
  priority    String   // 'Low', 'Medium', 'High'
  assignedTo  Int?     // User ID
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  facility    Facility @relation(fields: [facilityId], references: [id])
  assignee    User?    @relation(fields: [assignedTo], references: [id])

  @@map("maintenance_tasks")
}

model File {
  id          Int      @id @default(autoincrement())
  filename    String
  originalName String
  mimeType    String
  size        Int
  fileType    FileType @default(OTHER)
  filePath    String   // Relative path from uploads directory
  uploadedBy  Int
  clubId      Int?     // Tenant ID for row-level multi-tenancy
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  deletedAt   DateTime? // Soft delete

  // Relations
  uploader    User     @relation(fields: [uploadedBy], references: [id])

  @@map("files")
}

// =============================================================================
// System Settings Model
// =============================================================================

model SystemSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique  // e.g., 'platform_name', 'smtp_host', 'enable_registrations'
  value       String   // JSON string for complex values
  category    String   @default("general") // general, email, security, payments, notifications
  isEncrypted Boolean  @default(false) // For sensitive values like passwords
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// =============================================================================
// Email Template Model
// =============================================================================

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique  // e.g., 'welcome_email', 'password_reset'
  subject     String
  body        String   // HTML body of the email
  variables   String[] // Placeholder variables like ['{{name}}', '{{email}}']
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete

  @@map("email_templates")
}
